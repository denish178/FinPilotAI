PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb://mongodb:27017/finpilot

JWT_SECRET=REDACTED_JWT_SECRET_ROTATE_IN_RENDER
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REDACTED_JWT_REFRESH_SECRET_ROTATE_IN_RENDER
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:8080

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

RECURRING_CRON_ENABLED=true
RECURRING_CRON_SCHEDULE=5 0 * * *

LARGE_EXPENSE_THRESHOLD=5000

AI_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_UNUSUAL_EXPENSE_MULTIPLIER=2

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FinPilot AI <noreply@localhost>
