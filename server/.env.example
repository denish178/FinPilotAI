PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/finpilot

JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_at_least_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Recurring transactions scheduler (cron, UTC)
RECURRING_CRON_ENABLED=true
RECURRING_CRON_SCHEDULE=5 0 * * *

# Notify when a single expense exceeds this amount
LARGE_EXPENSE_THRESHOLD=5000

# AI Module (rule_based | openai)
AI_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_UNUSUAL_EXPENSE_MULTIPLIER=2

# Email — password reset & verification
# Without SMTP_HOST, links are printed in the API server console (dev only).
#
# Gmail (App Password required if 2FA is on):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_google_app_password
# EMAIL_FROM=FinPilot AI <you@gmail.com>
#
# Or use nodemailer preset:
# SMTP_SERVICE=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_google_app_password
# EMAIL_FROM=FinPilot AI <you@gmail.com>
#
# Local catcher (Mailpit / MailHog on port 1025):
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_AUTH_OPTIONAL=true
# EMAIL_FROM=FinPilot AI <dev@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=
SMTP_AUTH_OPTIONAL=false
SMTP_TLS_OPTIONAL=false
SMTP_TLS_INSECURE=false
EMAIL_FROM=FinPilot AI <noreply@localhost>
